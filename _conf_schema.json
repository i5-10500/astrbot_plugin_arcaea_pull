{
  "check_enabled": {
    "description": "启用定时更新检查",
    "type": "bool",
    "default": true
  },
  "check_interval_minutes": {
    "description": "检查间隔（分钟）",
    "type": "int",
    "default": 30,
    "slider": {
      "min": 1,
      "max": 1440,
      "step": 1
    }
  },
  "extra_check_times": {
    "description": "额外检查时间列表，格式为 HH:MM 或 HH:MM:SS",
    "type": "list",
    "default": []
  },
  "timezone": {
    "description": "IANA 时区",
    "type": "string",
    "default": "Asia/Shanghai"
  },
  "notify_targets": {
    "description": "允许接收状态通知的 AstrBot 统一会话标识列表",
    "type": "list",
    "default": []
  },
  "notify_on_update": {
    "description": "发现版本变化时通知",
    "type": "bool",
    "default": true
  },
  "notify_on_download_success": {
    "description": "下载成功时通知",
    "type": "bool",
    "default": true
  },
  "notify_on_error": {
    "description": "检查或下载失败时通知",
    "type": "bool",
    "default": false
  },
  "auto_download": {
    "description": "发现版本变化后自动下载 APK",
    "type": "bool",
    "default": false
  },
  "auto_flash_transfer": {
    "description": "预留配置；v0.2.3 不会自动分发 APK",
    "type": "bool",
    "default": false
  },
  "flash_transfer_targets": {
    "description": "允许接收 QQ 闪传的群号白名单",
    "type": "list",
    "default": []
  },
  "request_timeout": {
    "description": "APK 元数据 HTTP 请求的总超时秒数",
    "type": "int",
    "default": 30
  },
  "download_connect_timeout": {
    "description": "APK 下载连接建立超时秒数",
    "type": "int",
    "default": 30
  },
  "download_read_timeout": {
    "description": "APK 下载相邻数据块之间允许的最大空闲秒数；不限制下载总时长",
    "type": "int",
    "default": 120
  },
  "retry_count": {
    "description": "HTTP 最大尝试次数",
    "type": "int",
    "default": 3
  },
  "keep_old_versions": {
    "description": "保留旧版本 APK",
    "type": "bool",
    "default": true
  }
}

