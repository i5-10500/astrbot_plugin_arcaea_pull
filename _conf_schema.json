{
  "check_enabled": {
    "description": "启用每日更新检查",
    "type": "bool",
    "default": true
  },
  "check_time": {
    "description": "每日检查时间（HH:MM）",
    "type": "string",
    "default": "04:00"
  },
  "timezone": {
    "description": "IANA 时区",
    "type": "string",
    "default": "Asia/Shanghai"
  },
  "notify_targets": {
    "description": "允许接收状态通知的 AstrBot 统一会话标识列表",
    "type": "list",
    "default": []
  },
  "notify_on_update": {
    "description": "发现版本变化时通知",
    "type": "bool",
    "default": true
  },
  "notify_on_download_success": {
    "description": "下载成功时通知",
    "type": "bool",
    "default": true
  },
  "notify_on_error": {
    "description": "检查或下载失败时通知",
    "type": "bool",
    "default": false
  },
  "auto_download": {
    "description": "发现版本变化后自动下载 APK",
    "type": "bool",
    "default": false
  },
  "auto_flash_transfer": {
    "description": "预留配置；v0.2.1 不会自动分发 APK",
    "type": "bool",
    "default": false
  },
  "flash_transfer_targets": {
    "description": "允许接收 QQ 闪传的群号白名单",
    "type": "list",
    "default": []
  },
  "request_timeout": {
    "description": "HTTP 总超时秒数",
    "type": "int",
    "default": 30
  },
  "retry_count": {
    "description": "HTTP 最大尝试次数",
    "type": "int",
    "default": 3
  },
  "keep_old_versions": {
    "description": "保留旧版本 APK",
    "type": "bool",
    "default": true
  }
}

